<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd property list for the SiteBlock privileged helper.

  Ships inside the app bundle at Contents/Library/LaunchDaemons/today.siteblock.helper.plist and
  is registered via SMAppService.daemon(plistName: "today.siteblock.helper.plist"). The
  MachServices name MUST match HelperInfo.machServiceName in SiteBlockCore.

  Scripts/package.sh replaces TEAMID with your Apple Developer Team ID. Note SMAuthorizedClients
  is an SMJobBless-era key that SMAppService does not enforce: the helper itself rejects any XPC
  client not signed as today.siteblock.SiteBlock by its own team (see HelperInfo.clientRequirement).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>today.siteblock.helper</string>

    <key>BundleProgram</key>
    <string>Contents/MacOS/SiteBlockHelper</string>

    <key>MachServices</key>
    <dict>
        <key>today.siteblock.helper</key>
        <true/>
    </dict>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>today.siteblock.SiteBlock</string>
    </array>

    <!-- Only the signed SiteBlock app may talk to the helper. -->
    <key>SMAuthorizedClients</key>
    <array>
        <string>identifier "today.siteblock.SiteBlock" and anchor apple generic and certificate leaf[subject.OU] = "TEAMID"</string>
    </array>
</dict>
</plist>
